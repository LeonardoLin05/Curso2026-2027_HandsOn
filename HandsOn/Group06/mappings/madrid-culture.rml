@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix mc: <https://w3id.org/madrid-culture/ontology/> .

<#LibrariesMap> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "csv/libraries-updated.csv";
        rml:referenceFormulation ql:CSV
    ];

    rr:subjectMap [
        rr:template "https://w3id.org/madrid-culture/resource/library/{PK}";
        rr:class mc:Library
    ];

    rr:predicateObjectMap [ 
        rr:predicate rdfs:label; 
        rr:objectMap [ 
            rml:reference "NOMBRE";
            rr:termType rr:Literal;
            rr:datatype xsd:string
        ] 
    ];

    rr:predicateObjectMap [ 
        rr:predicate schema:name; 
        rr:objectMap [ 
            rml:reference "NOMBRE";
            rr:termType rr:Literal;
            rr:datatype xsd:string 
        ] 
    ];

    rr:predicateObjectMap [ 
        rr:predicate schema:openingHours; 
        rr:objectMap [ 
            rml:reference "HORARIO"; 
            rr:termType rr:Literal;
            rr:datatype xsd:string
        ] 
    ];

    rr:predicateObjectMap [ 
        rr:predicate mc:transport; 
        rr:objectMap [ 
            rml:reference "TRANSPORTE"; 
            rr:termType rr:Literal;
            rr:datatype xsd:string
        ] 
    ];

    rr:predicateObjectMap [ 
        rr:predicate schema:url; 
        rr:objectMap [ 
            rml:reference "CONTENT-URL"; 
            rr:termType rr:IRI 
        ] 
    ];

    rr:predicateObjectMap [ 
        rr:predicate mc:hasAddress; 
        rr:objectMap [ 
            rr:template "https://w3id.org/madrid-culture/resource/address/{PK}"; 
            rr:termType rr:IRI 
        ] 
    ];

    rr:predicateObjectMap [ 
        rr:predicate schema:latitude; 
        rr:objectMap [ 
            rml:reference "LATITUD"; 
            rr:termType rr:Literal;
            rr:datatype xsd:decimal 
        ] 
    ];

    rr:predicateObjectMap [ 
        rr:predicate schema:longitude; 
        rr:objectMap [ 
            rml:reference "LONGITUD"; 
            rr:termType rr:Literal;
            rr:datatype xsd:decimal 
        ] 
    ];

    rr:predicateObjectMap [ 
        rr:predicate schema:telephone; 
        rr:objectMap [ 
            rml:reference "TELEFONO"; 
            rr:termType rr:Literal;
            rr:datatype xsd:string
        ] 
    ];

    rr:predicateObjectMap [ 
        rr:predicate mc:email; 
        rr:objectMap [ 
            rml:reference "EMAIL"; 
            rr:termType rr:Literal;
            rr:datatype xsd:string 
        ] 
    ];

    rr:predicateObjectMap [ 
        rr:predicate mc:type; 
        rr:objectMap [ 
            rml:reference "TIPO"; 
            rr:termType rr:Literal;
            rr:datatype xsd:string 
        ] 
    ].

<#MuseumsMap> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "csv/museums-updated.csv";
        rml:referenceFormulation ql:CSV
    ];
    rr:subjectMap [
        rr:template "https://w3id.org/madrid-culture/resource/museum/{PK}" ;
        rr:class mc:Museum;
    ];

        rr:predicateObjectMap [ 
        rr:predicate rdfs:label; 
