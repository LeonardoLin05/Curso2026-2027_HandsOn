            rr:datatype xsd:string
        ] 
    ];

    rr:predicateObjectMap [ 
        rr:predicate mc:email; 
        rr:objectMap [ 
            rml:reference "EMAIL"; 
            rr:termType rr:Literal;
            rr:datatype xsd:string 
        ] 
    ];

    rr:predicateObjectMap [ 
        rr:predicate mc:type; 
        rr:objectMap [ 
            rml:reference "TIPO"; 
            rr:termType rr:Literal;
            rr:datatype xsd:string 
        ] 
    ].

<#LibraryAddressesMap> a rr:TriplesMap ;
    rml:logicalSource [ 
        rml:source "csv/libraries-updated.csv"; 
        rml:referenceFormulation ql:CSV 
    ];

    rr:subjectMap [
        rr:template "https://w3id.org/madrid-culture/resource/address/{PK}";
        rr:class mc:Address;
        rr:termType rr:IRI
    ];

    rr:predicateObjectMap [ 
        rr:predicate rdfs:label; 
        rr:objectMap [ 
            rml:reference "DIRECCION"; 
        ] 
    ];

    rr:predicateObjectMap [ 
        rr:predicate mc:streetAddress; 
        rr:objectMap [ 
            rml:reference "DIRECCION"; 
            rr:termType rr:Literal;
            rr:datatype xsd:string 
        ] 
    ];

    rr:predicateObjectMap [ 
        rr:predicate mc:postalCode; 
        rr:objectMap [ 
            rml:reference "CODIGO-POSTAL"; 
            rr:termType rr:Literal;
            rr:datatype xsd:string 
        ] 
    ];

    rr:predicateObjectMap [ 
        rr:predicate mc:locatedInDistrict; 
        rr:objectMap [ 
            rr:template "https://w3id.org/madrid-culture/resource/district/{COD-DISTRITO}"; 
            rr:termType rr:IRI 
        ] 
    ];

    rr:predicateObjectMap [ 
        rr:predicate mc:locatedInNeighborhood; 
        rr:objectMap [ 
            rr:template "https://w3id.org/madrid-culture/resource/neighborhood/{COD-DISTRITO}-{COD-BARRIO}"; 
            rr:termType rr:IRI 
        ] 
    ].

<#MuseumAddressesMap> a rr:TriplesMap ;
    rml:logicalSource [ 
        rml:source "csv/museums-updated.csv"; 
        rml:referenceFormulation ql:CSV 
    ];

    rr:subjectMap [
        rr:template "https://w3id.org/madrid-culture/resource/address/{PK}" ;
        rr:class mc:Address;
        rr:termType rr:IRI
    ];

    rr:predicateObjectMap [ 
        rr:predicate rdfs:label; 
        rr:objectMap [ 
            rml:reference "address_label"; 
        ] 
    ];

    rr:predicateObjectMap [ 
        rr:predicate mc:streetAddress; 
        rr:objectMap [ 
            rml:reference "DIRECCION"; 
            rr:termType rr:Literal;
            rr:datatype xsd:string 
        ] 
    ];

    rr:predicateObjectMap [ 
        rr:predicate mc:postalCode; 
        rr:objectMap [ 
            rml:reference "CODIGO-POSTAL"; 
            rr:termType rr:Literal;
            rr:datatype xsd:string 
        ] 
    ];

    rr:predicateObjectMap [ 
        rr:predicate mc:locatedInDistrict; 
        rr:objectMap [ 
            rr:template "https://w3id.org/madrid-culture/resource/district/{COD-DISTRITO}"; 
            rr:termType rr:IRI 
        ] 
    ];

    rr:predicateObjectMap [ 
        rr:predicate mc:locatedInNeighborhood; 
        rr:objectMap [ 
            rr:template "https://w3id.org/madrid-culture/resource/neighborhood/{COD-DISTRITO}-{COD-BARRIO}"; 
            rr:termType rr:IRI 
        ] 
    ].

<#DistrictsMap> a rr:TriplesMap;
    rml:logicalSource [ 
        rml:source "csv/clean/districts.csv"; 
        rml:referenceFormulation ql:CSV 
    ];

    rr:subjectMap [
        rr:template "https://w3id.org/madrid-culture/resource/district/{COD-DISTRITO}";
        rr:class mc:District;
        rr:termType rr:IRI
    ];

    rr:predicateObjectMap [ 
        rr:predicate rdfs:label; 
        rr:objectMap [ 
            rml:reference "DISTRITO"; 
        ] 
    ];

    rr:predicateObjectMap [ 
        rr:predicate schema:name; 
        rr:objectMap [ 
            rml:reference "DISTRITO"; 
        ] 
    ].

