<https://w3id.org/madrid-culture/resource/library/10395362> a mc:Library ;
    rdfs:label "Biblioteca Pública Municipal María Lejárraga" ;
    schema1:latitude 40.49041562546542 ;
    schema1:longitude -3.655356751728003 ;
    schema1:name "Biblioteca Pública Municipal María Lejárraga" ;
    schema1:openingHours "Apertura de lunes a domingo.  Horario: de lunes a viernes de 8:30 a 21 horas; sábados y domingos de 8:30 a 15 horas.   Horario de Verano (del 15 de junio al 15 de septiembre): de lunes a viernes de 8:30 a 20 horas; sábados y domingos de 8:30 a 14 horas.   Sala de Estudio: de lunes a viernes de 9 a 22 horas. Sábados, domingos y festivos: de 10 a 22 horas.  Cerrado: festivos, Semana Santa (de jueves a domingo), los dos últimos fines de semana de julio,  todos los fines de semana de agosto, el 24 y 31 de diciembre." ;
    schema1:telephone "91 513 33 83" ;
    schema1:url <http://www.madrid.es/sites/v/index.jsp?vgnextchannel=bfa48ab43d6bb410VgnVCM100000171f5a0aRCRD&vgnextoid=d862492de8c8c510VgnVCM2000001f4a900aRCRD> ;
    mc:email "bpmarialejarraga@madrid.es" ;
    mc:hasAccessibility <https://w3id.org/madrid-culture/resource/accessibility/10395362> ;
    mc:hasAddress <https://w3id.org/madrid-culture/resource/address/10395362> ;
    mc:transport "Metro: Blasco Ibáñez y Virgen del Cortijo (línea C2 Metro Ligero)" ;
    mc:type "BibliotecasPublicas" .

